# Deploy only runtime/build essentials and /chat assets.
# Keep package.json + build scripts so Vercel can run npm install/build.

/*
!/.git
!/.git/**
!/.gitmodules
!/nanomem
!/chat
!/chat/**
!/local_inference
!/local_inference/**
!/scripts
!/scripts/**
!/package.json
!/package-lock.json
!/vercel.json
!/.vercelignore
