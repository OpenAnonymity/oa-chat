# Deploy only runtime/build essentials and /chat assets.
# Keep package.json + build scripts so Vercel can run npm install/build.

/*
!/.gitmodules
!/nanomem
!/chat
!/chat/**
!/vector
!/vector/**
!/local_inference
!/local_inference/**
!/scripts
!/scripts/**
!/patches
/patches/*
!/patches/zkapi-browser-sdk-wallet-recovery.mjs
!/deployments
/deployments/*
!/deployments/zkapi
/deployments/zkapi/*
!/deployments/zkapi/fresh-20260928
/deployments/zkapi/fresh-20260928/*
!/deployments/zkapi/fresh-20260928/mainnet.json
!/deployments/zkapi/fresh-20260928/sepolia.json
!/deployments/zkapi/fresh-20260930
/deployments/zkapi/fresh-20260930/*
!/deployments/zkapi/fresh-20260930/mainnet.json
!/deployments/zkapi/fresh-20260930/sepolia.json
!/package.json
!/package-lock.json
!/vercel.json
!/.vercelignore

# Final deny rules must follow every broad allowlist above so a future nested
# repository or local environment file cannot be re-included in the upload.
**/.git
**/.git/**
.env
.env.*
**/.env
**/.env.*
