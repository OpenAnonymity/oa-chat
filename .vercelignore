# Deploy only runtime/build essentials and /chat assets.
# Keep package.json + build scripts so Vercel can run npm install/build.

/*
!/.gitmodules
!/nanomem
!/chat
!/chat/**
!/vector
!/vector/**
!/local_inference
!/local_inference/**
!/scripts
!/scripts/**
!/patches
/patches/*
!/patches/zkapi-browser-sdk-wallet-recovery.mjs
!/patches/zkapi-browser-sdk-v2c-recovery.mjs
!/patches/zkapi-browser-sdk-proof-cache.mjs
!/patches/zkapi-browser-sdk-provider-verification.mjs
!/patches/zkapi-browser-sdk-v2c-provider-verification.mjs
!/patches/zkapi-browser-sdk-v3-recovery.mjs
!/patches/zkapi-browser-sdk-v3-provider-verification.mjs
!/patches/zkapi-browser-sdk-v3-gasless-recovery.mjs
!/patches/zkapi-browser-sdk-v3-gasless-provider-verification.mjs
!/patches/zkapi-browser-sdk-v4-recovery.mjs
!/patches/zkapi-browser-sdk-v4-provider-verification.mjs
!/deployments
/deployments/*
!/deployments/zkapi
/deployments/zkapi/*
!/deployments/zkapi/mainnet.json
!/deployments/zkapi/sepolia.json
!/deployments/zkapi/registry.json
!/package.json
!/package-lock.json
!/vercel.json
!/.vercelignore

# Final deny rules must follow every broad allowlist above so a future nested
# repository or local environment file cannot be re-included in the upload.
**/.git
**/.git/**
.env
.env.*
**/.env
**/.env.*
