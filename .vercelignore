# Deploy only runtime/build essentials and /chat assets.
# Keep package.json + build scripts so Vercel can run npm install/build.

/*
!/.gitmodules
!/nanomem
!/chat
!/chat/**
!/vector
!/vector/**
!/local_inference
!/local_inference/**
!/scripts
!/scripts/**
!/patches
/patches/*
# Every reviewed SDK patch imported by scripts/patch-zkapi-sdk.mjs must ship:
# postinstall/build refuse to run without the full hash-checked chain.
!/patches/zkapi-browser-sdk-wallet-recovery.mjs
!/patches/zkapi-browser-sdk-proof-cache.mjs
!/patches/zkapi-browser-sdk-provider-verification.mjs
!/patches/zkapi-browser-sdk-server-time.mjs
!/deployments
/deployments/*
!/deployments/zkapi
/deployments/zkapi/*
!/deployments/zkapi/mainnet.json
!/deployments/zkapi/sepolia.json
!/package.json
!/package-lock.json
!/vercel.json
!/.vercelignore

# Final deny rules must follow every broad allowlist above so a future nested
# repository or local environment file cannot be re-included in the upload.
**/.git
**/.git/**
.env
.env.*
**/.env
**/.env.*
