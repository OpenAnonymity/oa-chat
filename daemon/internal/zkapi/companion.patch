+fn oa_verifier_outage(status: Option<u16>, result: &Value, expires_at: u64, evidence: &OaKeyVerificationEvidence) -> Result<OaVerificationOutcome, AuthError> {
+    let fail = || AuthError::KeyVerification("verifier refused key or outage policy does not permit this key".into());
+    if expires_at <= now_seconds() { return Err(fail()); }
+    let temporary_ownership = status == Some(503) && result["status"] == "unverified" && result["detail"] == "ownership_check_error";
+    if oa_verifier_hard_failure(result, temporary_ownership) { return Err(fail()); }
+    let detail = if temporary_ownership { "ownership_check_error" }
+        else if status == Some(429) { "rate_limited" }
+        else {
+            if !evidence.station_recently_attested
+                || !matches!(status, None | Some(408 | 500 | 502 | 503 | 504))
+                || !matches!(result.get("status").and_then(Value::as_str), None | Some("error" | "unavailable")) {
+                return Err(fail());
+            }
+            "recently_attested_outage"
+        };
+    Ok(OaVerificationOutcome { verified: false, detail: Some(detail) })
+}
