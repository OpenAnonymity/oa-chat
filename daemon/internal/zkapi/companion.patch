+    pub async fn oa_prepare_withdrawal(&self, destination: [u8; 20]) -> Result<WithdrawalPlan, AuthError> {
+        if destination == [0; 20] { return Err(AuthError::InvalidInput("withdrawal destination cannot be zero".into())); }
+        // Same order as issuance: lease mutex, wallet mutex, then filesystem lock.
+        // Hold all three through clearance so no inference can race the snapshot.
+        let mut lease = self.direct_lease.lock().await;
+        let config = self.config.clone();
+        let wallet_mutex = self.wallet_mutex.clone();
+        let indexer = self.indexer.clone();
+        let trusted_roots = self.trusted_roots();
+        let result = spawn_blocking(move || {
+            let _guard = wallet_mutex.lock().map_err(|_| AuthError::Wallet("wallet lock unavailable".into()))?;
+            let _lockfile = acquire_wallet_lock(&config.state_dir)?;
+            let mut wallet = load_wallet(&config, trusted_roots)?;
+            let existing = crate::oa_withdrawal::load(&config)?;
+            // Parse errors must never be treated as absence of a pending lease.
+            let pending = wallet.get_pending_journal()?.is_some();
+            // A missing active file after finalized close can be the last crash
+            // boundary. Never recreate a note or ask for a second clearance.
+            if wallet.state().is_none() {
+                if pending { return Err(AuthError::PendingSettlement); }
+                if let Some(record) = &existing {
+                    if record.destination != destination { return Err(AuthError::WithdrawalConflict); }
+                    return record.plan.clone().ok_or(AuthError::WithdrawalConflict);
+                }
+                return Err(AuthError::NoActiveNote);
+            }
+            let runtime = current_thread_runtime()?;
+            runtime.block_on(async move {
+                if wallet.get_pending_journal()?.is_some() {
+                    if existing.as_ref().is_some_and(|record| !record.complete) {
+                        return Err(AuthError::PendingSettlement);
+                    }
+                    wallet.recover().await?;
+                    if wallet.get_pending_journal()?.is_some() { return Err(AuthError::PendingSettlement); }
+                }
+                let state = wallet.state().ok_or(AuthError::NoActiveNote)?;
+                let mut record = crate::oa_withdrawal::reserve(&config, state, destination)?;
+                if record.complete { return record.plan.ok_or(AuthError::WithdrawalConflict); }
+                // Clearance is idempotent for this reserved nullifier. Rebuild a
+                // proof against the current Merkle root on every explicit retry.
+                let root = indexer.root().await?;
+                let siblings = indexer.note_path(state.note_id).await?;
+                let (public_inputs, proof) = wallet.withdrawal_mutual_close(destination, root, siblings.clone()).await?;
+                let plan = WithdrawalPlan { mode: WithdrawalMode::Mutual, public_inputs, siblings, proof };
+                crate::oa_withdrawal::validate_plan(&record, &plan)?;
+                record.plan = Some(plan.clone());
+                crate::oa_withdrawal::save(&config, &record)?;
+                Ok(plan)
+            })
+        }).await;
+        if result.is_ok() { *lease = None; }
+        result
+    }
