+    #[tokio::test]
+    async fn verify_oa_key_posts_original_signed_expiry_and_evidence() {
+        use axum::{extract::State, routing::post, Json, Router};
+        use serde_json::{json, Value};
+        use sha2::{Digest, Sha256};
+        use std::sync::{Arc, Mutex};
+
+        async fn submit(
+            State(seen): State<Arc<Mutex<Vec<Value>>>>,
+            Json(body): Json<Value>,
+        ) -> Json<Value> {
+            seen.lock().unwrap().push(body);
+            let hash = format!("{:x}", Sha256::digest(b"test-key"));
+            Json(json!({"status":"verified", "station_id":"test-station", "key_hash":&hash[..16]}))
+        }
+        let seen = Arc::new(Mutex::new(Vec::<Value>::new()));
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let verifier_url = format!("http://{}", listener.local_addr().unwrap());
+        let app = Router::new().route("/submit_key", post(submit)).with_state(seen.clone());
+        let server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+        let directory = tempfile::tempdir().unwrap();
+        let service = super::AuthService::new(crate::config::AuthConfig {
+            state_dir: directory.path().to_path_buf(),
+            oa_verifier_url: verifier_url.clone(),
+            protocol_server_url: verifier_url.clone(),
+            request_mode: crate::config::RequestMode::DirectOpenrouter,
+            require_oa_org_key_source: true,
+            ..Default::default()
+        }).unwrap();
+        let mut evidence = super::OaKeyVerificationEvidence {
+            verifier_url,
+            station_id: "test-station".into(),
+            station_recently_attested: true,
+            key_valid_till: 1_000,
+            station_signature: "ab".repeat(64),
+            org_signature: "cd".repeat(64),
+        };
+        for signed_expiry in [1_000, 1_030, 1_060] {
+            evidence.key_valid_till = signed_expiry;
+            service.verify_oa_key("test-key", 1_000, &evidence).await.unwrap();
+            assert_eq!(seen.lock().unwrap().last().unwrap(), &json!({
+                "station_id":"test-station", "api_key":"test-key",
+                "key_valid_till":signed_expiry,
+                "station_signature":evidence.station_signature,
+                "org_signature":evidence.org_signature,
+            }));
+        }
+        for signed_expiry in [999, 1_061, u64::MAX] {
+            evidence.key_valid_till = signed_expiry;
+            assert!(matches!(service.verify_oa_key("test-key", 1_000, &evidence).await,
+                Err(super::AuthError::KeyVerification(_))));
+        }
+        assert_eq!(seen.lock().unwrap().len(), 3, "invalid expiry must fail before HTTP submission");
+
+        let lease_expiry = super::now_seconds() + 300;
+        evidence.key_valid_till = lease_expiry + 30;
+        *service.direct_lease.lock().await = Some(super::ActiveOpenRouterLease {
+            client_request_id: "test-existing-lease".into(),
+            api_key: "test-key".into(),
+            openrouter_api_base: "https://openrouter.ai/api/v1".into(),
+            expires_at: lease_expiry,
+            settle_after: lease_expiry + 5,
+            verification: Some(evidence.clone()),
+            verified: false,
+        });
+        let handout = service.oa_bridge_lease().await.unwrap();
+        assert_eq!(handout["expires_at"], lease_expiry, "signed-key margin must not extend usable lease");
+        assert_eq!(handout["verified"], true);
+        assert_eq!(seen.lock().unwrap().last().unwrap()["key_valid_till"], lease_expiry + 30);
+        assert_eq!(seen.lock().unwrap().len(), 4);
+        server.abort();
+    }
