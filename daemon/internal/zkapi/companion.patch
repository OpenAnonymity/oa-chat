+//! Native ETH quote checks. Never trust the payment server's conversion alone.
+use crate::{config::AuthConfig, error::AuthError};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Quote {
+    pub asset: String,
+    pub units_per_eth: u64,
+    pub chain_id: u64,
+    pub feed_address: String,
+    pub round_id: String,
+    pub answer: String,
+    pub decimals: u8,
+    pub updated_at: u64,
+    pub expires_at: u64,
+}
+fn invalid() -> AuthError {
+    AuthError::Wallet(
+        "native ETH billing quote is invalid, stale, or disagrees with the finalized oracle".into(),
+    )
+}
+fn decimal(value: &str) -> Result<u128, AuthError> {
+    if value.is_empty()
+        || value.len() > 39
+        || !value.bytes().all(|b| b.is_ascii_digit())
+        || (value.len() > 1 && value.starts_with('0'))
+    {
+        return Err(invalid());
+    }
+    value.parse().map_err(|_| invalid())
+}
+impl Quote {
+    pub fn validate(&self, config: &AuthConfig, allow_expired: bool) -> Result<(), AuthError> {
+        let round = decimal(&self.round_id)?;
+        let answer = decimal(&self.answer)?;
+        if config.billing_asset != "native_eth"
+            || config.billing_unit != "gwei"
+            || config.native_asset_wei_per_unit != "1000000000"
+            || config.demo_billing_token_address.is_some()
+            || config.native_price_feed_decimals != 8
+            || config.native_price_max_age_seconds == 0
+            || config.native_price_max_age_seconds > 86400
+            || self.asset != "native_eth"
+            || self.units_per_eth != 1_000_000_000
+            || self.chain_id != config.chain_id
+            || self.feed_address != config.native_price_feed_address.to_ascii_lowercase()
+            || self.decimals != config.native_price_feed_decimals
+            || round == 0
+            || round >= 1u128 << 80
+            || answer == 0
+            || answer > 1_000_000_000_000_000_000
+            || self.updated_at == 0
+            || self.updated_at > crate::service::now_seconds()
+            || self
+                .updated_at
+                .checked_add(config.native_price_max_age_seconds)
+                != Some(self.expires_at)
+            || (!allow_expired && self.expires_at <= crate::service::now_seconds())
+        {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+    pub fn budget_units(&self, micro_usd: u128) -> Result<u128, AuthError> {
+        if ![1_000_000, 2_000_000, 3_000_000, 4_500_000, 6_000_000].contains(&micro_usd) {
+            return Err(invalid());
+        }
+        let numerator = micro_usd
+            .checked_mul(100_000_000_000_000_000u128)
+            .ok_or_else(invalid)?;
+        let denominator = decimal(&self.answer)?
+            .checked_mul(1_000_000)
+            .ok_or_else(invalid)?;
+        let units = numerator / denominator + u128::from(numerator % denominator != 0);
+        if units == 0 || units > 9_007_199_254_740_991 {
+            return Err(invalid());
+        }
+        Ok(units)
+    }
+    pub fn usd_micros(&self, units: u128) -> Result<u128, AuthError> {
+        if units == 0 || units > 9_007_199_254_740_991 {
+            return Err(invalid());
+        }
+        let value = units
+            .checked_mul(decimal(&self.answer)?)
+            .and_then(|n| n.checked_mul(1_000_000))
+            .ok_or_else(invalid)?
+            / 100_000_000_000_000_000u128;
+        if value == 0 || value > 9_007_199_254_740_991 {
+            return Err(invalid());
+        }
+        Ok(value)
+    }
+}
+async fn json_response(mut response: reqwest::Response) -> Result<Value, AuthError> {
+    if !response.status().is_success() {
+        return Err(invalid());
+    }
+    let mut body = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(|_| invalid())? {
+        if body.len() + chunk.len() > 65536 {
+            return Err(invalid());
+        }
+        body.extend_from_slice(&chunk);
+    }
+    serde_json::from_slice(&body).map_err(|_| invalid())
+}
+async fn rpc(config: &AuthConfig, method: &str, params: Value) -> Result<Value, AuthError> {
+    let url = config.demo_rpc_url.as_ref().ok_or_else(invalid)?;
+    let body = json_response(
+        crate::service::fresh_private_http()?
+            .post(url)
+            .timeout(std::time::Duration::from_secs(20))
+            .json(&json!({"jsonrpc":"2.0","id":1,"method":method,"params":params}))
+            .send()
+            .await
+            .map_err(|_| invalid())?,
+    )
+    .await?;
+    if body["jsonrpc"] != "2.0" || body["id"] != 1 || body.get("error").is_some() {
+        return Err(invalid());
+    }
+    body.get("result").cloned().ok_or_else(invalid)
+}
+fn hex_u128(value: &Value) -> Result<u128, AuthError> {
+    let text = value
+        .as_str()
+        .and_then(|v| v.strip_prefix("0x"))
+        .ok_or_else(invalid)?;
+    if text.is_empty() || !text.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err(invalid());
+    }
+    u128::from_str_radix(text.trim_start_matches('0').trim(), 16)
+        .or_else(|_| {
+            if text.bytes().all(|b| b == b'0') {
+                Ok(0)
+            } else {
+                Err(())
+            }
+        })
+        .map_err(|_| invalid())
+}
+fn block_identity(block: &Value) -> Result<(&str, &str), AuthError> {
+    let number = block["number"].as_str().ok_or_else(invalid)?;
+    hex_u128(&block["number"])?;
+    let hash = block["hash"].as_str().ok_or_else(invalid)?;
+    if !hash.starts_with("0x")
+        || hash.len() != 66
+        || !hash[2..].bytes().all(|b| b.is_ascii_hexdigit())
+    {
+        return Err(invalid());
+    }
+    Ok((number, hash))
+}
+pub(crate) async fn verified_quote(config: &AuthConfig) -> Result<Quote, AuthError> {
+    let response = zkapi_client::testnet_auth::request(config.chain_id, &config.protocol_server_url, reqwest::Method::GET, format!(
+                "{}/v2/billing/quote",
+                config.protocol_server_url.trim_end_matches('/')
+            ))?
+            .timeout(std::time::Duration::from_secs(20))
+            .send()
+            .await
+            .map_err(|_| invalid())?;
+    let proposed = json_response(zkapi_client::testnet_auth::check_response(response)?).await?;
+    let quote: Quote = serde_json::from_value(proposed).map_err(|_| invalid())?;
+    quote.validate(config, false)?;
+    if hex_u128(&rpc(config, "eth_chainId", json!([])).await?)? != config.chain_id as u128 {
+        return Err(invalid());
+    }
+    let block = rpc(config, "eth_getBlockByNumber", json!(["finalized", false])).await?;
+    let (number, hash) = block_identity(&block)?;
+    let vault = format!(
+        "0x{}",
+        config.contract_address.as_bytes()[12..]
+            .iter()
+            .map(|b| format!("{b:02x}"))
+            .collect::<String>()
+    );
+    for (data, expected) in [("0x4d1352fd", 1_000_000_000u128), ("0x631b2f10", 0)] {
+        let result = rpc(
+            config,
+            "eth_call",
+            json!([{"to":vault,"data":data},"latest"]),
+        )
+        .await?;
+        if result.as_str().is_none_or(|s| s.len() != 66) || hex_u128(&result)? != expected {
+            return Err(invalid());
+        }
+    }
+    let decimals = rpc(
+        config,
+        "eth_call",
+        json!([{"to":config.native_price_feed_address,"data":"0x313ce567"},number]),
+    )
+    .await?;
+    if hex_u128(&decimals)? != quote.decimals as u128 {
+        return Err(invalid());
+    }
+    let encoded = rpc(
+        config,
+        "eth_call",
+        json!([{"to":config.native_price_feed_address,"data":"0xfeaf968c"},number]),
+    )
+    .await?;
+    let encoded = encoded.as_str().ok_or_else(invalid)?;
+    if encoded.len() != 322
+        || !encoded.starts_with("0x")
+        || !encoded[2..].bytes().all(|b| b.is_ascii_hexdigit())
+    {
+        return Err(invalid());
+    }
+    let words = (0..5)
+        .map(|i| {
+            hex_u128(&json!(format!(
+                "0x{}",
+                &encoded[2 + i * 64..2 + (i + 1) * 64]
+            )))
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    if words[0] != decimal(&quote.round_id)?
+        || words[1] != decimal(&quote.answer)?
+        || words[2] == 0
+        || words[2] > words[3]
+        || words[3] != quote.updated_at as u128
+        || words[4] < words[0]
+    {
+        return Err(invalid());
+    }
+    let canonical = rpc(config, "eth_getBlockByNumber", json!([number, false])).await?;
+    let (_, canonical_hash) = block_identity(&canonical)?;
+    if !canonical_hash.eq_ignore_ascii_case(hash)
+        || hex_u128(&rpc(config, "eth_chainId", json!([])).await?)? != config.chain_id as u128
+    {
+        return Err(invalid());
+    }
+    Ok(quote)
+}
+pub(crate) fn saved_quote(config: &AuthConfig, payload: &str) -> Result<Option<Quote>, AuthError> {
+    let mut value: Value = serde_json::from_str(payload).map_err(|_| invalid())?;
+    let object = value.as_object_mut().ok_or_else(invalid)?;
+    let quote = object
+        .remove("billing_quote")
+        .map(serde_json::from_value::<Quote>)
+        .transpose()
+        .map_err(|_| invalid())?;
+    let authorization: zkapi_types::wire::OpenRouterLeaseAuthorization =
+        serde_json::from_value(value).map_err(|_| invalid())?;
+    if authorization != Default::default() {
+        return Err(invalid());
+    }
+    match (&*config.billing_asset, &quote) {
+        ("native_eth", Some(quote)) => quote.validate(config, true)?,
+        ("native_eth", None) => return Err(invalid()),
+        (_, Some(_)) => return Err(invalid()),
+        _ => {}
+    }
+    Ok(quote)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn fixture() -> (AuthConfig, Quote) {
+        let config = AuthConfig {
+            billing_asset: "native_eth".into(),
+            billing_unit: "gwei".into(),
+            native_asset_wei_per_unit: "1000000000".into(),
+            native_price_feed_address: format!("0x{}", "12".repeat(20)),
+            native_price_feed_decimals: 8,
+            native_price_max_age_seconds: 3600,
+            ..Default::default()
+        };
+        let updated = crate::service::now_seconds() - 60;
+        let quote = Quote {
+            asset: "native_eth".into(),
+            units_per_eth: 1_000_000_000,
+            chain_id: config.chain_id,
+            feed_address: config.native_price_feed_address.clone(),
+            round_id: "123".into(),
+            answer: "250000000000".into(),
+            decimals: 8,
+            updated_at: updated,
+            expires_at: updated + 3600,
+        };
+        (config, quote)
+    }
+    #[test]
+    fn native_budget_and_saved_quote_bindings_are_exact() {
+        let (config, quote) = fixture();
+        quote.validate(&config, false).unwrap();
+        assert_eq!(quote.budget_units(1_000_000).unwrap(), 400_000);
+        assert_eq!(quote.usd_micros(400_000).unwrap(), 1_000_000);
+        assert!(quote.budget_units(7_000_000).is_err());
+        let mut changed = quote.clone();
+        changed.answer = "300000000001".into();
+        assert_eq!(changed.budget_units(1_000_000).unwrap(), 333_334);
+        let payload =
+            json!({"mode":"openrouter_ephemeral_lease","version":1,"billing_quote":quote})
+                .to_string();
+        assert_eq!(saved_quote(&config, &payload).unwrap(), Some(quote.clone()));
+        assert!(saved_quote(
+            &config,
+            r#"{"mode":"openrouter_ephemeral_lease","version":1}"#
+        )
+        .is_err());
+        for (field, value) in [
+            ("chain_id", json!(111)),
+            ("feed_address", json!(format!("0x{}", "34".repeat(20)))),
+            ("answer", json!("0")),
+            ("round_id", json!("0123")),
+            ("units_per_eth", json!(1)),
+            ("expires_at", json!(0)),
+        ] {
+            let mut value_quote = serde_json::to_value(&quote).unwrap();
+            value_quote[field] = value;
+            assert!(serde_json::from_value::<Quote>(value_quote)
+                .unwrap()
+                .validate(&config, true)
+                .is_err());
+        }
+        let mut expired = quote.clone();
+        expired.updated_at = 1;
+        expired.expires_at = 3601;
+        assert!(expired.validate(&config, false).is_err());
+        assert!(expired.validate(&config, true).is_ok());
+    }
+    #[tokio::test]
+    async fn oracle_requires_finalized_round_chain_vault_and_canonical_block() {
+        use axum::{
+            routing::{get, post},
+            Json, Router,
+        };
+        use std::sync::{
+            atomic::{AtomicU8, Ordering},
+            Arc,
+        };
+        let (mut config, quote) = fixture();
+        let mode = Arc::new(AtomicU8::new(0));
+        let quote_response = quote.clone();
+        let rpc_quote = quote.clone();
+        let modes = mode.clone();
+        let router=Router::new().route("/v2/billing/quote",get(move||{let q=quote_response.clone();async move {Json(json!(q))}}))
+            .route("/rpc",post(move|Json(body):Json<Value>|{let q=rpc_quote.clone();let mode=modes.load(Ordering::SeqCst);async move {
+                let result=match body["method"].as_str().unwrap() {
+                    "eth_chainId"=>json!(if mode==1{"0x2"}else{"0x1"}),
+                    "eth_getBlockByNumber"=>json!({"number":"0x10","hash":format!("0x{}",if mode==2 && body["params"][0]=="0x10"{"bb".repeat(32)}else{"aa".repeat(32)})}),
+                    "eth_call"=>match body["params"][0]["data"].as_str().unwrap() {
+                        "0x4d1352fd"=>json!(format!("0x{:064x}",if mode==3{0}else{1_000_000_000u128})),
+                        "0x631b2f10"=>json!(format!("0x{:064x}",if mode==4{1}else{0})),
+                        "0x313ce567"=>json!(format!("0x{:064x}",if mode==5{9}else{8})),
+                        "0xfeaf968c"=>json!(format!("0x{:064x}{:064x}{:064x}{:064x}{:064x}",if mode==6{124}else{123},250_000_000_000u128,q.updated_at-1,q.updated_at,123)),_=>panic!("unexpected call")},_=>panic!("unexpected method")};
+                Json(json!({"jsonrpc":"2.0","id":1,"result":result}))
+            }}));
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!("http://{}", listener.local_addr().unwrap());
+        config.protocol_server_url = url.clone();
+        config.demo_rpc_url = Some(format!("{url}/rpc"));
+        let server = tokio::spawn(async move { axum::serve(listener, router).await.unwrap() });
+        assert_eq!(verified_quote(&config).await.unwrap(), quote);
+        for value in 1..=6 {
+            mode.store(value, Ordering::SeqCst);
+            assert!(verified_quote(&config).await.is_err(), "mode {value}");
+        }
+        server.abort();
+    }
+}
diff --git a/crates/zkapi-clientd/src/oa_withdrawal.rs b/crates/zkapi-clientd/src/oa_withdrawal.rs
new file mode 100644
index 0000000..a1c8287
--- /dev/null
+++ b/crates/zkapi-clientd/src/oa_withdrawal.rs
@@ -0,0 +1,734 @@
+//! Durable OA withdrawal reservation. Every call runs under the wallet lock.
+//! The snapshot is local recovery material and is never returned over HTTP.
+use std::fs::{self, File, OpenOptions};
+use std::io::Write;
+use std::path::Path;
+use std::time::Duration;
+
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use sha3::{Digest, Keccak256};
+use zkapi_client::note_state::NoteState;
+use zkapi_core::v2;
+use zkapi_types::Felt252;
+
+use crate::config::AuthConfig;
+use crate::error::AuthError;
+use crate::service::{WithdrawalMode, WithdrawalPlan};
+
+const FILE: &str = "oa-withdrawal.json";
+
+#[derive(Clone, Serialize, Deserialize)]
+pub(crate) struct Reservation {
+    version: u8,
+    pub snapshot: NoteState,
+    pub destination: [u8; 20],
+    pub nullifier: Felt252,
+    pub plan: Option<WithdrawalPlan>,
+    pub complete: bool,
+    pub transaction_hash: Option<String>,
+}
+
+fn storage_error() -> AuthError {
+    AuthError::Wallet(
+        "withdrawal recovery storage is unavailable or invalid; preserve its files".into(),
+    )
+}
+
+pub(crate) fn destination(value: &str) -> Result<[u8; 20], AuthError> {
+    let bytes = hex_bytes(value, 20)?;
+    let mut result = [0; 20];
+    result.copy_from_slice(&bytes);
+    if result == [0; 20] {
+        return Err(AuthError::InvalidInput(
+            "withdrawal destination cannot be the zero address".into(),
+        ));
+    }
+    Ok(result)
+}
+
+fn hex_bytes(value: &str, size: usize) -> Result<Vec<u8>, AuthError> {
+    if !value.starts_with("0x")
+        || value.len() != 2 + size * 2
+        || !value[2..].bytes().all(|b| b.is_ascii_hexdigit())
+    {
+        return Err(AuthError::InvalidInput(
+            "invalid withdrawal hexadecimal value".into(),
+        ));
+    }
+    (2..value.len())
+        .step_by(2)
+        .map(|i| {
+            u8::from_str_radix(&value[i..i + 2], 16)
+                .map_err(|_| AuthError::InvalidInput("invalid withdrawal hexadecimal value".into()))
+        })
+        .collect()
+}
+
+fn hex(value: &[u8]) -> String {
+    format!(
+        "0x{}",
+        value.iter().map(|b| format!("{b:02x}")).collect::<String>()
+    )
+}
+
+fn same_state(left: &NoteState, right: &NoteState) -> bool {
+    matches!((serde_json::to_value(left), serde_json::to_value(right)), (Ok(left), Ok(right)) if left == right)
+}
+
+pub(crate) fn load(config: &AuthConfig) -> Result<Option<Reservation>, AuthError> {
+    let path = config.state_dir.join(FILE);
+    let metadata = match fs::symlink_metadata(&path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(_) => return Err(storage_error()),
+    };
+    if !metadata.is_file() || metadata.len() > 1 << 20 {
+        return Err(storage_error());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        if metadata.permissions().mode() & 0o777 != 0o600 {
+            return Err(storage_error());
+        }
+    }
+    let record: Reservation = serde_json::from_slice(&fs::read(path).map_err(|_| storage_error())?)
+        .map_err(|_| storage_error())?;
+    if record.version != 1
+        || record.snapshot.protocol_version != config.protocol_version
+        || record.snapshot.chain_id != config.chain_id
+        || record.snapshot.contract_address != config.contract_address
+        || record.destination == [0; 20]
+        || record.nullifier
+            != v2::nullifier(&record.snapshot.secret_s, &record.snapshot.current_anchor)
+        || (record.complete && record.transaction_hash.is_none())
+    {
+        return Err(storage_error());
+    }
+    if let Some(plan) = &record.plan {
+        validate_plan(&record, plan)?;
+    }
+    if let Some(hash) = &record.transaction_hash {
+        hex_bytes(hash, 32)?;
+    }
+    Ok(Some(record))
+}
+
+pub(crate) fn reserve(
+    config: &AuthConfig,
+    state: &NoteState,
+    destination: [u8; 20],
+) -> Result<Reservation, AuthError> {
+    if state.protocol_version != config.protocol_version
+        || state.chain_id != config.chain_id
+        || state.contract_address != config.contract_address
+        || destination == [0; 20]
+    {
+        return Err(AuthError::WithdrawalConflict);
+    }
+    if let Some(previous) = load(config)? {
+        if previous.complete && previous.snapshot.note_id != state.note_id {
+            archive(
+                config,
+                &previous,
+                "reservation",
+                &serde_json::to_vec(&previous).map_err(|_| storage_error())?,
+            )?;
+        } else {
+            if previous.destination != destination || !same_state(&previous.snapshot, state) {
+                return Err(AuthError::WithdrawalConflict);
+            }
+            return Ok(previous);
+        }
+    }
+    let record = Reservation {
+        version: 1,
+        snapshot: state.clone(),
+        destination,
+        nullifier: v2::nullifier(&state.secret_s, &state.current_anchor),
+        plan: None,
+        complete: false,
+        transaction_hash: None,
+    };
+    save(config, &record)?;
+    Ok(record)
+}
+
+pub(crate) fn save(config: &AuthConfig, record: &Reservation) -> Result<(), AuthError> {
+    atomic_write(
+        &config.state_dir.join(FILE),
+        &serde_json::to_vec(record).map_err(|_| storage_error())?,
+    )
+}
+
+pub(crate) fn check_spending(config: &AuthConfig, note_id: Option<u32>) -> Result<(), AuthError> {
+    if let Some(record) = load(config)? {
+        if !record.complete || note_id == Some(record.snapshot.note_id) {
+            return Err(AuthError::WithdrawalConflict);
+        }
+    }
+    Ok(())
+}
+
+pub(crate) fn validate_plan(record: &Reservation, plan: &WithdrawalPlan) -> Result<(), AuthError> {
+    let inputs = &plan.public_inputs;
+    if plan.mode != WithdrawalMode::Mutual
+        || !inputs.has_clearance
+        || inputs.protocol_version != record.snapshot.protocol_version
+        || inputs.chain_id != record.snapshot.chain_id
+        || inputs.contract_address != record.snapshot.contract_address
+        || inputs.note_id != record.snapshot.note_id
+        || inputs.final_balance != record.snapshot.current_balance
+        || inputs.destination != record.destination
+        || inputs.withdrawal_nullifier != record.nullifier
+        || plan.siblings.len() != 32
+        || inputs.withdrawal_tag
+            != v2::withdrawal_tag(
+                &record.nullifier,
+                &inputs.destination_field(),
+                inputs.final_balance,
+                true,
+            )
+    {
+        return Err(AuthError::WithdrawalConflict);
+    }
+    Ok(())
+}
+
+pub(crate) fn public_status(record: Option<&Reservation>) -> Value {
+    match record {
+        None => json!({"phase": "none"}),
+        Some(record) => {
+            let mut status = json!({"phase": if record.complete {"complete"} else {"reserved"},
+                "note_id": record.snapshot.note_id, "destination": hex(&record.destination),
+                "final_balance": record.snapshot.current_balance.to_string(), "withdrawal_nullifier": hex(record.nullifier.as_bytes())});
+            if let Some(hash) = &record.transaction_hash {
+                status["transaction_hash"] = json!(hash);
+            }
+            status
+        }
+    }
+}
+
+fn atomic_write(path: &Path, bytes: &[u8]) -> Result<(), AuthError> {
+    #[cfg(unix)]
+    use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+    let temporary = path.with_extension("tmp");
+    let mut options = OpenOptions::new();
+    options.write(true).create(true).truncate(true);
+    #[cfg(unix)]
+    options.mode(0o600);
+    let mut file = options.open(&temporary).map_err(|_| storage_error())?;
+    #[cfg(unix)]
+    file.set_permissions(fs::Permissions::from_mode(0o600))
+        .map_err(|_| storage_error())?;
+    file.write_all(bytes)
+        .and_then(|_| file.sync_all())
+        .map_err(|_| storage_error())?;
+    fs::rename(&temporary, path).map_err(|_| storage_error())?;
+    File::open(path.parent().ok_or_else(storage_error)?)
+        .and_then(|f| f.sync_all())
+        .map_err(|_| storage_error())
+}
+
+fn archive(
+    config: &AuthConfig,
+    record: &Reservation,
+    label: &str,
+    bytes: &[u8],
+) -> Result<(), AuthError> {
+    let directory = config.state_dir.join("archive");
+    fs::create_dir_all(&directory).map_err(|_| storage_error())?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        fs::set_permissions(&directory, fs::Permissions::from_mode(0o700))
+            .map_err(|_| storage_error())?;
+    }
+    File::open(&config.state_dir)
+        .and_then(|f| f.sync_all())
+        .map_err(|_| storage_error())?;
+    atomic_write(
+        &directory.join(format!(
+            "oa-withdrawal-{}-{}-{label}.json",
+            record.snapshot.note_id,
+            record.nullifier.to_hex()
+        )),
+        bytes,
+    )
+}
+
+// Called only after independently checking canonical finalized payout evidence.
+pub(crate) fn complete(
+    config: &AuthConfig,
+    record: &mut Reservation,
+    hash: &str,
+) -> Result<(), AuthError> {
+    let active_path = config.state_dir.join("note_state.json");
+    if active_path.exists() {
+        let active = NoteState::load(&active_path).map_err(|_| storage_error())?;
+        if !same_state(&active, &record.snapshot) {
+            return Err(AuthError::WithdrawalConflict);
+        }
+    }
+    if zkapi_client::journal::PendingRequestJournal::read(
+        &config.state_dir.join("pending_journal.json"),
+    )?
+    .is_some()
+    {
+        return Err(AuthError::PendingSettlement);
+    }
+    archive(
+        config,
+        record,
+        "note",
+        &serde_json::to_vec(&record.snapshot).map_err(|_| storage_error())?,
+    )?;
+    record.transaction_hash = Some(hash.to_lowercase());
+    save(config, record)?;
+    match fs::remove_file(&active_path) {
+        Ok(()) => {}
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+        Err(_) => return Err(storage_error()),
+    }
+    File::open(&config.state_dir)
+        .and_then(|f| f.sync_all())
+        .map_err(|_| storage_error())?;
+    record.complete = true;
+    save(config, record)
+}
+
+async fn rpc(config: &AuthConfig, method: &str, params: Value) -> Result<Value, AuthError> {
+    let failure = || {
+        AuthError::Wallet("withdrawal RPC unavailable or invalid; preserve saved progress".into())
+    };
+    let url = config.demo_rpc_url.as_deref().ok_or_else(failure)?;
+    let parsed = reqwest::Url::parse(url).map_err(|_| failure())?;
+    if parsed.scheme() != "https"
+        || !parsed.username().is_empty()
+        || parsed.password().is_some()
+        || parsed.fragment().is_some()
+    {
+        return Err(failure());
+    }
+    // New clients inherit the daemon's authenticated local CONNECT proxy,
+    // using direct TCP or Wisp with no fallback or account authorization header.
+    let client = reqwest::Client::builder()
+        .timeout(Duration::from_secs(20))
+        .redirect(reqwest::redirect::Policy::none())
+        .build()
+        .map_err(|_| failure())?;
+    let mut response = client
+        .post(url)
+        .json(&json!({"jsonrpc":"2.0","id":1,"method":method,"params":params}))
+        .send()
+        .await
+        .map_err(|_| failure())?;
+    if !response.status().is_success() {
+        return Err(failure());
+    }
+    let mut bytes = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(|_| failure())? {
+        if bytes.len() + chunk.len() > 1 << 20 {
+            return Err(failure());
+        }
+        bytes.extend_from_slice(&chunk);
+    }
+    let response: Value = serde_json::from_slice(&bytes).map_err(|_| failure())?;
+    if response["id"] != 1
+        || response["jsonrpc"] != "2.0"
+        || response.get("error").is_some()
+        || response.get("result").is_none()
+    {
+        return Err(failure());
+    }
+    Ok(response["result"].clone())
+}
+
+fn quantity(value: &Value) -> Result<u64, AuthError> {
+    let text = value.as_str().ok_or_else(storage_error)?;
+    u64::from_str_radix(text.strip_prefix("0x").ok_or_else(storage_error)?, 16)
+        .map_err(|_| storage_error())
+}
+
+pub(crate) fn validate_close_event(
+    record: &Reservation,
+    receipt: &Value,
+    hash: &str,
+) -> Result<(), AuthError> {
+    if receipt["status"] != "0x1"
+        || !receipt["transactionHash"]
+            .as_str()
+            .is_some_and(|value| value.eq_ignore_ascii_case(hash))
+    {
+        return Err(AuthError::InvalidInput(
+            "withdrawal receipt is not a successful matching transaction".into(),
+        ));
+    }
+    let topic = format!(
+        "0x{:x}",
+        Keccak256::digest(b"MutualClose(uint32,uint256,uint128,address)")
+    );
+    let vault = hex(&record.snapshot.contract_address.as_bytes()[12..]);
+    let note_topic = format!("0x{:064x}", record.snapshot.note_id);
+    // All event parameters except indexed noteId are fixed ABI words.
+    let expected_data = format!(
+        "{}{:064x}{}{}",
+        hex(record.nullifier.as_bytes()),
+        record.snapshot.current_balance,
+        "0".repeat(24),
+        &hex(&record.destination)[2..]
+    );
+    let matches = receipt["logs"]
+        .as_array()
+        .ok_or_else(storage_error)?
+        .iter()
+        .filter(|log| {
+            log["removed"] != true
+                && log["address"]
+                    .as_str()
+                    .is_some_and(|value| value.eq_ignore_ascii_case(&vault))
+                && log["topics"].as_array().is_some_and(|topics| {
+                    topics.len() == 2
+                        && topics[0]
+                            .as_str()
+                            .is_some_and(|value| value.eq_ignore_ascii_case(&topic))
+                        && topics[1]
+                            .as_str()
+                            .is_some_and(|value| value.eq_ignore_ascii_case(&note_topic))
+                })
+                && log["data"]
+                    .as_str()
+                    .is_some_and(|value| value.eq_ignore_ascii_case(&expected_data))
+        })
+        .count();
+    if matches != 1 {
+        return Err(AuthError::InvalidInput(
+            "withdrawal receipt has no unique matching MutualClose payout event".into(),
+        ));
+    }
+    Ok(())
