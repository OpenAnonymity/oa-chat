+fn oa_verifier_hard_failure(result: &Value, temporary_ownership: bool) -> bool {
+    let status = result.get("status").and_then(Value::as_str).unwrap_or("");
+    if result.get("status").is_some_and(|value| !value.is_string())
+        || result.get("banned_station").is_some_and(|value| !value.is_null() && *value != Value::Bool(false))
+        || ["banned", "rejected", "denied", "invalid"].contains(&status)
+        || (status == "unverified" && !temporary_ownership)
+        || result.get("ownership_passed") == Some(&Value::Bool(false))
+        || result.pointer("/ownership/ownership_passed") == Some(&Value::Bool(false)) {
+        return true;
+    }
+    for field in ["error", "detail", "message"] {
+        let text = result.get(field).map(|value| value.as_str().map(str::to_string).unwrap_or_else(|| value.to_string())).unwrap_or_default().to_ascii_lowercase();
+        if ["invalid signature", "signature mismatch", "expired", "invalid key", "privacy", "logging", "training", "banned"].iter().any(|term| text.contains(term))
+            || (text.contains("ownership") && (text.contains("mismatch") || text.contains("failed"))) {
+            return true;
+        }
+    }
+    false
+}
