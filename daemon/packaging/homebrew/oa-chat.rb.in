# Generated by daemon/scripts/assemble-release.py; do not edit checksums manually.
class OaChat < Formula
  desc "Local inference API with Open Anonymity ticket and ZKAPI access"
  homepage "https://github.com/OpenAnonymity/oa-chat"
  version "@@VERSION@@"
  license "MIT"

  on_macos do
    depends_on macos: :ventura
    on_arm do
      url "@@BASE_URL@@/oa-chat_@@VERSION@@_darwin_arm64.tar.gz"
      sha256 "@@DARWIN_ARM64_SHA256@@"
    end
    on_intel do
      url "@@BASE_URL@@/oa-chat_@@VERSION@@_darwin_amd64.tar.gz"
      sha256 "@@DARWIN_AMD64_SHA256@@"
    end
  end

  on_linux do
    depends_on "openssl@3"
    depends_on "patchelf" => :build
    on_arm do
      url "@@BASE_URL@@/oa-chat_@@VERSION@@_linux_arm64.tar.gz"
      sha256 "@@LINUX_ARM64_SHA256@@"
    end
    on_intel do
      url "@@BASE_URL@@/oa-chat_@@VERSION@@_linux_amd64.tar.gz"
      sha256 "@@LINUX_AMD64_SHA256@@"
    end
  end

  def install
    bin.install "oa-chat", "oa-zkapi"
    (share/"doc/oa-chat").install "CLI_PACKAGING.md"
    prefix.install "LICENSE"
    share.install "share/oa-chat"

    # Release ELF binaries use OpenSSL's SONAME; brewed libraries are keg-only.
    # Put the managed dependency in RUNPATH so services need no loader variables.
    if OS.linux?
      system Formula["patchelf"].opt_bin/"patchelf", "--add-rpath",
             Formula["openssl@3"].opt_lib, bin/"oa-zkapi"
    end
  end

  service do
    run [opt_bin/"oa-chat", "serve"]
    keep_alive true
    environment_variables PATH: std_service_path_env
    log_path var/"log/oa-chat.log"
    error_log_path var/"log/oa-chat.log"
    restart_delay 5
    stop_timeout 30
  end

  def caveats
    <<~EOS
      Initialize your private configuration before starting the service:
        oa-chat init
        brew services start oa-chat
      Run these commands as your own user. Each user has a separate wallet.
      Client API base URL: http://127.0.0.1:8787/v1
    EOS
  end

  test do
    assert_match "oa-chat #{version}", shell_output("#{bin}/oa-chat version")
    assert_match "Usage:", shell_output("#{bin}/oa-zkapi --help")
    %w[request.pk request.vk withdrawal.pk withdrawal.vk manifest.json].each do |asset|
      assert_predicate share/"oa-chat/proof-setup"/asset, :file?
      assert_operator (share/"oa-chat/proof-setup"/asset).size, :>, 0
    end
  end
end
