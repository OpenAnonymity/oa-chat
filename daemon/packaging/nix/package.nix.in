# Generated by daemon/scripts/assemble-release.py from the exact release archives.
{ lib, stdenv, fetchurl, makeWrapper, autoPatchelfHook, openssl, cacert }:
let
  version = "@@VERSION@@";
  archives = {
    x86_64-linux = { target = "linux_amd64"; sha256 = "@@LINUX_AMD64_SHA256@@"; };
    aarch64-linux = { target = "linux_arm64"; sha256 = "@@LINUX_ARM64_SHA256@@"; };
    x86_64-darwin = { target = "darwin_amd64"; sha256 = "@@DARWIN_AMD64_SHA256@@"; };
    aarch64-darwin = { target = "darwin_arm64"; sha256 = "@@DARWIN_ARM64_SHA256@@"; };
  };
  archive = archives.${stdenv.hostPlatform.system} or
    (throw "oa-chat binary releases do not support ${stdenv.hostPlatform.system}");
in
stdenv.mkDerivation {
  pname = "oa-chat";
  inherit version;
  src = fetchurl {
    url = "@@BASE_URL@@/oa-chat_${version}_${archive.target}.tar.gz";
    inherit (archive) sha256;
  };

  # Native archives have their payload at the top level, without a source root.
  sourceRoot = ".";
  dontConfigure = true;
  dontBuild = true;
  dontStrip = true;
  nativeBuildInputs = [ makeWrapper ] ++ lib.optionals stdenv.hostPlatform.isLinux [ autoPatchelfHook ];
  buildInputs = lib.optionals stdenv.hostPlatform.isLinux [ openssl stdenv.cc.cc.lib ];

  installPhase = ''
    runHook preInstall
    install -Dm755 oa-chat "$out/bin/oa-chat"
    install -Dm755 oa-zkapi "$out/bin/oa-zkapi"
    mkdir -p "$out/share/doc/oa-chat" "$out/share/licenses/oa-chat"
    cp -R share/oa-chat "$out/share/oa-chat"
    install -m644 CLI_PACKAGING.md "$out/share/doc/oa-chat/CLI_PACKAGING.md"
    install -m644 LICENSE "$out/share/licenses/oa-chat/LICENSE"
    install -m644 VERSION "$out/share/oa-chat/VERSION"
    ${lib.optionalString stdenv.hostPlatform.isLinux ''
      install -Dm644 oa-chat.service "$out/lib/systemd/user/oa-chat.service"
      substituteInPlace "$out/lib/systemd/user/oa-chat.service" \
        --replace-fail /usr/bin/oa-chat "$out/bin/oa-chat"
    ''}
    # The bundled companion wins over an unrelated executable in the user's PATH.
    # Keep oa-zkapi unwrapped: its resolved ../share directory locates the proof keys.
    wrapProgram "$out/bin/oa-chat" \
      --prefix PATH : "$out/bin" \
      --set-default SSL_CERT_FILE "${cacert}/etc/ssl/certs/ca-bundle.crt"
    runHook postInstall
  '';

  doInstallCheck = true;
  installCheckPhase = ''
    runHook preInstallCheck
    test "$("$out/bin/oa-chat" version)" = "oa-chat ${version}"
    "$out/bin/oa-zkapi" --help >/dev/null
    for asset in request.pk request.vk withdrawal.pk withdrawal.vk manifest.json; do
      test -s "$out/share/oa-chat/proof-setup/$asset"
    done
    runHook postInstallCheck
  '';

  meta = {
    description = "Local inference API with Open Anonymity ticket and ZKAPI access";
    homepage = "https://github.com/OpenAnonymity/oa-chat";
    license = lib.licenses.mit;
    mainProgram = "oa-chat";
    platforms = builtins.attrNames archives;
    sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
  };
}
