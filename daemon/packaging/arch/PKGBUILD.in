# Generated by daemon/scripts/assemble-release.py.
pkgname=oa-chat-bin
pkgver=@@VERSION@@
pkgrel=1
pkgdesc='Local inference API with Open Anonymity ticket and ZKAPI access'
arch=('x86_64' 'aarch64')
url='https://github.com/OpenAnonymity/oa-chat'
license=('MIT')
depends=('ca-certificates' 'glibc>=2.39' 'gcc-libs' 'openssl')
optdepends=('systemd: user service management' 'xdg-utils: open the funding browser')
provides=('oa-chat')
conflicts=('oa-chat')
source_x86_64=("oa-chat_${pkgver}_linux_amd64.tar.gz::@@BASE_URL@@/oa-chat_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("oa-chat_${pkgver}_linux_arm64.tar.gz::@@BASE_URL@@/oa-chat_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('@@LINUX_AMD64_SHA256@@')
sha256sums_aarch64=('@@LINUX_ARM64_SHA256@@')

package() {
    install -Dm755 oa-chat "${pkgdir}/usr/bin/oa-chat"
    install -Dm755 oa-zkapi "${pkgdir}/usr/bin/oa-zkapi"
    install -Dm644 oa-chat.service "${pkgdir}/usr/lib/systemd/user/oa-chat.service"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 CLI_PACKAGING.md "${pkgdir}/usr/share/doc/oa-chat/CLI_PACKAGING.md"
    install -d "${pkgdir}/usr/share"
    cp -a share/oa-chat "${pkgdir}/usr/share/"
}
